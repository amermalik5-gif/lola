---
import Base from '../../../layouts/Base.astro';
import ProductCard from '../../../components/ProductCard.astro';
import Swatches from '../../../components/Swatches.astro';
import Icon from '../../../components/Icon.astro';
import site from '../../../../content/site.json';
import { t, url, pick, LANGS, type Lang } from '../../../lib/i18n';
import { products, specsFor, labelOf, type Product } from '../../../lib/products';

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    products.map((product) => ({
      params: { locale: lang === 'ar' ? undefined : lang, slug: product.slug },
      props: { lang, product },
    })),
  );
}

const { lang, product: p } = Astro.props as { lang: Lang; product: Product };
const d = t(lang);
const pd = d.products;
const name = pick(p.name, lang)!;
const description = pick(p.description, lang)!;
const specs = specsFor(p, lang);
const related = products.filter((x) => x.category === p.category && x.slug !== p.slug).slice(0, 4);
const catLabel = d.common.categories[p.category as keyof typeof d.common.categories];
const soon = p.status === 'soon';
const isMixer = p.category !== 'accessories';
const waText = `${d.common.whatsappMessage} ${labelOf(p, lang)}`;
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(waText)}`;
const quote = `${url(lang, 'contact')}?type=project&product=${encodeURIComponent(p.slug)}`;
const sheets = [
  { lang: 'ar', label: pd.datasheetAr, file: p.datasheet.ar },
  { lang: 'en', label: pd.datasheetEn, file: p.datasheet.en },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description,
  ...(p.code ? { sku: p.code } : {}),
  category: catLabel,
  brand: { '@type': 'Brand', name: 'Loaloah' },
  manufacturer: { '@type': 'Organization', name: 'Loaloah Industries' },
  countryOfOrigin: 'SA',
  image: p.images.map((i) => new URL(i, site.url).href),
  url: new URL(url(lang, `products/${p.slug}`), site.url).href,
};
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: d.nav.home, item: new URL(url(lang), site.url).href },
    { '@type': 'ListItem', position: 2, name: d.nav.products, item: new URL(url(lang, 'products'), site.url).href },
    { '@type': 'ListItem', position: 3, name },
  ],
};
---
<Base lang={lang} title={`${name}${p.code ? ` ${p.code}` : ''} | ${d.meta.siteName}`} description={description} path={`products/${p.slug}`} jsonLd={[jsonLd, crumbs]} solidHeader>
  <section class="pdp">
    <div class="wrap pdp__grid">
      <div class="pdp__gallery">
        <div class="pdp__stage">
          <img src={p.images[0]} alt={name} width="1000" height="1100" decoding="async" fetchpriority="high" />
          {soon && <span class="pdp__soon">{d.common.status.soon}</span>}
        </div>
        {p.images.length > 1 && (
          <ul role="list" class="pdp__thumbs">
            {p.images.map((src, i) => <li><img src={src} alt={`${name} ${i + 1}`} loading="lazy" width="200" height="220" /></li>)}
          </ul>
        )}
      </div>

      <div class="pdp__info">
        <nav class="crumbs" aria-label="breadcrumb">
          <ol role="list">
            <li><a href={url(lang)}>{d.nav.home}</a></li>
            <li><a href={url(lang, 'products')}>{d.nav.products}</a></li>
            <li><a href={`${url(lang, 'products')}?c=${p.category}`}>{catLabel}</a></li>
          </ol>
        </nav>

        <div class="pdp__titles">
          <p class="kicker">{catLabel}</p>
          <h1 class="pdp__name" data-split data-split-now>{name}</h1>
          <dl class="pdp__ids">
            {p.code && <div><dt>{d.common.code}</dt><dd class="mono" dir="ltr">{p.code}</dd></div>}
            {soon && <div><dt>{d.common.availability}</dt><dd>{d.common.status.soon}</dd></div>}
          </dl>
        </div>

        <p class="pdp__desc" data-reveal>{description}</p>

        {p.finishes.length > 0 && (
          <div class="pdp__block" data-reveal>
            <h2 class="pdp__h">{pd.finishes}</h2>
            <Swatches finishes={p.finishes} lang={lang} size="md" labels />
          </div>
        )}

        <div class="pdp__ctas" data-reveal>
          <a class="btn" href={quote} data-magnetic>{soon ? pd.notify : pd.quote}<Icon name="arrow" class="arrow" /></a>
          <a class="btn btn--ghost" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" class="arrow" />{pd.whatsapp}</a>
        </div>

        <div class="pdp__block" data-reveal>
          <h2 class="pdp__h">{pd.datasheet}</h2>
          <ul role="list" class="sheets">
            {sheets.map((s) => (
              <li>
                {s.file ? (
                  <a class="sheet" href={s.file} download><Icon name="file" /><span>{pd.datasheet} · {s.label}</span><Icon name="download" /></a>
                ) : (
                  <span class="sheet is-disabled" aria-disabled="true"><Icon name="file" /><span>{pd.datasheet} · {s.label}</span><span class="chip">{d.common.status.soon}</span></span>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--mist specs-sec">
    <div class="window-light"></div>
    <div class="wrap specs-sec__grid">
      <div>
        <p class="kicker" data-reveal>{p.code ?? catLabel}</p>
        <h2 class="h-2" data-split>{pd.specs}</h2>
      </div>
      <div>
        <dl class="specs" data-reveal-group>
          {specs.map((s) => (
            <div class="specs__row" data-reveal>
              <dt>{s.label}</dt>
              <dd dir="auto">{s.value}</dd>
            </div>
          ))}
        </dl>
        {isMixer && !soon && (
          <aside class="cert-note" data-reveal>
            <span class="chip chip--inProgress">{d.common.status.inProgress}</span>
            <div>
              <h3>{pd.certTitle}</h3>
              <p>{pd.certBody}</p>
            </div>
          </aside>
        )}
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section related">
      <div class="wrap">
        <div class="related__head">
          <h2 class="h-2" data-split>{pd.related}</h2>
          <a class="link-arrow" href={url(lang, 'products')}>{pd.back}<Icon name="arrow" /></a>
        </div>
        <ul role="list" class="related__grid" data-reveal-group>
          {related.map((r) => <li data-reveal><ProductCard product={r} lang={lang} /></li>)}
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .pdp {
    padding-block: calc(var(--header-h) + clamp(24px, 4vw, 48px)) clamp(56px, 8vw, 112px);
  }
  .pdp__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 88px);
    align-items: start;
  }
  .pdp__gallery {
    position: sticky;
    top: calc(var(--header-h) + 20px);
  }
  .pdp__stage {
    position: relative;
    border-radius: var(--r-lg);
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: hidden;
  }
  .pdp__stage img {
    width: 100%;
    height: auto;
  }
  .pdp__soon {
    position: absolute;
    inset-block-start: 20px;
    inset-inline-end: 20px;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--gold);
    color: var(--ink);
    font-size: var(--fs-small);
    font-weight: 700;
  }
  .pdp__thumbs {
    display: flex;
    gap: 10px;
    margin-block-start: 10px;
  }
  .pdp__thumbs img {
    width: 80px;
    border-radius: var(--r-sm);
  }
  .pdp__info {
    display: grid;
    gap: 28px;
    padding-block-start: 8px;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: var(--fs-small);
    color: var(--text-2);
  }
  .crumbs li + li::before {
    content: '/';
    margin-inline-end: 6px;
    opacity: 0.5;
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--atlantic);
    text-decoration: underline;
  }
  .pdp__titles {
    display: grid;
    gap: 14px;
  }
  .pdp__name {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.6rem);
  }
  .pdp__ids {
    display: flex;
    gap: 28px;
    font-size: var(--fs-small);
  }
  .pdp__ids dt {
    color: var(--text-2);
  }
  .pdp__ids dd {
    margin: 0;
    font-weight: 600;
  }
  .pdp__desc {
    font-size: 1.15rem;
    color: var(--text-2);
    max-width: 48ch;
  }
  .pdp__block {
    display: grid;
    gap: 14px;
    padding-block-start: 24px;
    border-block-start: 1px solid var(--line);
  }
  .pdp__h {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--text-2);
  }
  .pdp__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .sheets {
    display: grid;
    gap: 8px;
  }
  .sheet {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: var(--r-sm);
    background: var(--mist);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: background-color 0.3s;
  }
  .sheet > span:first-of-type {
    flex: 1;
  }
  .sheet :global(svg) {
    width: 20px;
    height: 20px;
    color: var(--atlantic);
    flex: none;
  }
  a.sheet:hover {
    background: var(--azure-100);
  }
  .sheet.is-disabled {
    color: var(--text-2);
  }

  .specs-sec__grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(32px, 5vw, 88px);
  }
  .specs {
    border-block-start: 1px solid var(--line-strong);
  }
  .specs__row {
    display: grid;
    grid-template-columns: minmax(120px, 0.6fr) 1fr;
    gap: 20px;
    padding-block: 18px;
    border-block-end: 1px solid var(--line);
  }
  .specs__row dt {
    color: var(--text-2);
    font-size: 0.95rem;
  }
  .specs__row dd {
    margin: 0;
    font-weight: 600;
  }
  .cert-note {
    display: flex;
    gap: 16px;
    align-items: start;
    margin-block-start: 28px;
    padding: 20px;
    border-radius: var(--r);
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .cert-note h3 {
    font-size: 1rem;
    margin-block-end: 4px;
  }
  .cert-note p {
    color: var(--text-2);
    font-size: 0.95rem;
  }

  .related__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-block-end: 36px;
  }
  .related__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 20px;
  }

  @media (max-width: 960px) {
    .pdp__grid,
    .specs-sec__grid {
      grid-template-columns: 1fr;
    }
    .pdp__gallery {
      position: static;
    }
  }
  @media (max-width: 520px) {
    .specs__row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .cert-note {
      flex-direction: column;
    }
  }
</style>
