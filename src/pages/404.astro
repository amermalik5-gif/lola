---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PetalLines from '../components/PetalLines.astro';
import { t, url } from '../lib/i18n';
const ar = t('ar').notFound;
const en = t('en').notFound;
---
<Base lang="ar" title={`${ar.title} | 404`}>
  <section class="nf on-dark">
    <PetalLines class="nf__petals" filled={2} />
    <div class="wrap nf__inner">
      <p class="nf__code mono" dir="ltr">404</p>
      <h1 class="h-display">{ar.title}</h1>
      <p class="lead">{ar.body}</p>
      <a class="btn btn--light" href={url('ar')}>{ar.cta}<Icon name="arrow" class="arrow" /></a>
      <p class="nf__en" lang="en" dir="ltr">{en.title}. <a href={url('en')}>{en.cta}</a></p>
    </div>
  </section>
</Base>
<style>
  .nf {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    overflow: hidden;
    background: var(--grad-radial);
    color: #fff;
    padding-block: calc(var(--header-h) + 40px) 80px;
  }
  .nf :global(.nf__petals) {
    position: absolute;
    width: min(900px, 120vw);
    inset-inline-start: -10%;
    bottom: -30%;
    opacity: 0.5;
  }
  .nf__inner {
    position: relative;
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .nf__code {
    font-size: clamp(5rem, 16vw, 12rem);
    line-height: 0.9;
    color: var(--azure);
  }
  .nf__en {
    color: var(--text-on-dark-2);
    font-size: var(--fs-small);
  }
</style>
