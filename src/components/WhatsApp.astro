---
import Icon from './Icon.astro';
import site from '../../content/site.json';
import { t, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const href = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(d.common.whatsappMessage)}`;
---
<a class="wa-fab" href={href} target="_blank" rel="noopener" title={d.common.whatsappAria} data-magnetic>
  <Icon name="whatsapp" />
  <span class="wa-fab__label">{d.contact.details.whatsapp}</span>
</a>
<style>
  .wa-fab {
    position: fixed;
    inset-inline-end: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 56px;
    padding-inline: 16px 18px;
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    box-shadow: 0 1px 0 rgba(11, 23, 71, 0.06), 0 18px 40px -18px rgba(11, 23, 71, 0.45);
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  }
  .wa-fab :global(svg) {
    width: 26px;
    height: 26px;
    color: #128c4b;
  }
  .wa-fab:hover {
    box-shadow: 0 1px 0 rgba(11, 23, 71, 0.06), 0 22px 48px -16px rgba(11, 23, 71, 0.55);
  }
  @media (max-width: 640px) {
    .wa-fab {
      width: 56px;
      padding: 0;
      justify-content: center;
    }
    .wa-fab__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
</style>
