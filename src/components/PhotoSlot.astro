---
// Placeholder for photography that hasn't been shot yet. Built from the
// guideline's pattern element so it reads as intentional, and labelled honestly.
import { PETALS } from '../lib/brand';
interface Props { caption: string; status: string; src?: string; alt?: string; class?: string; ratio?: string }
const { caption, status, src, alt = '', class: cls, ratio = '4 / 3' } = Astro.props;
const id = `pp${Math.random().toString(36).slice(2, 7)}`;
---
<figure class:list={['photo', cls]} style={`aspect-ratio:${ratio}`}>
  {src ? (
    <img src={src} alt={alt} loading="lazy" decoding="async" data-parallax="10" />
  ) : (
    <div class="photo__ph" aria-hidden="true">
      <svg width="100%" height="100%" data-parallax="8">
        <defs>
          <pattern id={id} width="68" height="56" patternUnits="userSpaceOnUse" patternTransform="rotate(-18)">
            <g transform="scale(.26)" fill="none" stroke="rgba(255,255,255,.28)" stroke-width="3">{PETALS.map((d) => <path d={d} />)}</g>
          </pattern>
        </defs>
        <rect width="100%" height="140%" y="-20%" fill={`url(#${id})`} />
      </svg>
    </div>
  )}
  <figcaption class="photo__cap">
    <span>{caption}</span>
    {!src && <span class="photo__status">{status}</span>}
  </figcaption>
</figure>
<style>
  .photo {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--grad-linear);
    isolation: isolate;
  }
  .photo img,
  .photo__ph,
  .photo__ph svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo__ph svg {
    height: 130%;
    top: -15%;
  }
  .photo__cap {
    position: absolute;
    inset-inline: 16px;
    bottom: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    color: #fff;
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .photo__status {
    padding: 5px 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(6px);
    font-weight: 500;
    font-size: var(--fs-micro);
  }
</style>
