---
import ProductDrawing from './ProductDrawing.astro';
import Swatches from './Swatches.astro';
import Icon from './Icon.astro';
import { t, url, pick, type Lang } from '../lib/i18n';
import type { Product } from '../lib/products';

interface Props { product: Product; lang: Lang; class?: string }
const { product: p, lang, class: cls } = Astro.props;
const d = t(lang);
const name = pick(p.name, lang)!;
---
<article class:list={['pcard', cls]} data-category={p.category}>
  <a class="pcard__link" href={url(lang, `products/${p.slug}`)}>
    <div class="pcard__media">
      {p.images.length ? (
        <img src={p.images[0]} alt={name} loading="lazy" decoding="async" width="800" height="880" />
      ) : (
        <ProductDrawing kind={p.drawing.kind as any} shape={p.drawing.shape as any} code={p.code} />
      )}
      <span class="pcard__cat">{d.common.categoriesShort[p.category as keyof typeof d.common.categoriesShort]}</span>
    </div>
    <div class="pcard__body">
      <div class="pcard__meta">
        <span class="mono" dir="ltr">{p.code}</span>
        {p.collection && <span>{d.common.collections[p.collection as keyof typeof d.common.collections]}</span>}
      </div>
      <h3 class="pcard__name">{name}</h3>
      <div class="pcard__foot">
        {p.finishes.length > 0 && <Swatches finishes={p.finishes} lang={lang} />}
        <span class="pcard__go" aria-hidden="true"><Icon name="arrow" /></span>
      </div>
    </div>
  </a>
</article>

<style>
  .pcard {
    position: relative;
    height: 100%;
  }
  .pcard__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--r);
    background: var(--paper);
    text-decoration: none;
    overflow: hidden;
    box-shadow: 0 0 0 1px var(--line);
    transition: box-shadow 0.5s var(--ease-out), transform 0.6s var(--ease-out);
  }
  .pcard__link:hover {
    transform: translateY(-6px);
    box-shadow: 0 0 0 1px rgba(58, 161, 219, 0.5), 0 30px 60px -32px rgba(2, 84, 151, 0.45);
  }
  .pcard__media {
    position: relative;
    aspect-ratio: 400 / 440;
    background:
      radial-gradient(80% 60% at 50% 60%, #fff 0%, transparent 70%),
      linear-gradient(180deg, var(--mist) 0%, #fff 100%);
    overflow: hidden;
  }
  .pcard__media > :global(svg),
  .pcard__media > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-out);
  }
  .pcard__link:hover .pcard__media > :global(svg),
  .pcard__link:hover .pcard__media > img {
    transform: scale(1.04);
  }
  .pcard__cat {
    position: absolute;
    inset-block-start: 14px;
    inset-inline-start: 14px;
    padding: 5px 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(8px);
    font-size: var(--fs-micro);
    font-weight: 600;
    color: var(--atlantic);
  }
  .pcard__body {
    display: grid;
    gap: 8px;
    padding: 18px 20px 20px;
    border-block-start: 1px solid var(--line);
    flex: 1;
  }
  .pcard__meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: var(--fs-micro);
    color: var(--text-2);
  }
  .pcard__meta .mono {
    letter-spacing: 0.06em;
  }
  .pcard__name {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .pcard__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-start: auto;
    padding-block-start: 6px;
    min-height: 32px;
  }
  .pcard__go {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-inline-start: auto;
    border-radius: 50%;
    background: var(--mist);
    color: var(--atlantic);
    transition: background-color 0.3s, color 0.3s, transform 0.5s var(--ease-out);
  }
  .pcard__go :global(svg) {
    width: 16px;
    height: 16px;
  }
  :global([dir='rtl']) .pcard__go :global(svg) {
    transform: scaleX(-1);
  }
  .pcard__link:hover .pcard__go {
    background: var(--atlantic);
    color: #fff;
    transform: translateX(var(--nudge, 3px));
  }
  :global([dir='rtl']) .pcard__link:hover .pcard__go {
    --nudge: -3px;
  }
</style>
