---
import Icon from './Icon.astro';
import PetalLines from './PetalLines.astro';
import site from '../../content/site.json';
import { t, url, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).home.distributor;
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(t(lang).common.whatsappMessage)}`;
---
<section class="dist">
  <div class="wrap">
    <div class="dist__card on-dark">
      <PetalLines class="dist__petals" filled={1} />
      <div class="dist__copy">
        <p class="kicker" data-reveal>{d.kicker}</p>
        <h2 class="h-display dist__title" data-split>{d.title}</h2>
        <p class="lead" data-reveal>{d.body}</p>
        <ul role="list" class="dist__regions" data-reveal-group>
          {d.regions.map((r, i) => <li data-reveal><span class="mono">{String(i + 1).padStart(2, '0')}</span>{r}</li>)}
        </ul>
        <div class="dist__ctas" data-reveal>
          <a class="btn btn--light" href={`${url(lang, 'contact')}?type=distributor`} data-magnetic>{d.cta}<Icon name="arrow" class="arrow" /></a>
          <a class="btn btn--ghost" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" class="arrow" />{d.secondary}</a>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .dist {
    padding-block: clamp(24px, 4vw, 64px) var(--section);
  }
  .dist__card {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--grad-linear);
    color: #fff;
    padding: clamp(32px, 6vw, 96px);
    isolation: isolate;
  }
  .dist__card :global(.dist__petals) {
    position: absolute;
    z-index: -1;
    width: min(760px, 120%);
    inset-inline-end: -10%;
    top: -20%;
    opacity: 0.55;
  }
  .dist__copy {
    display: grid;
    gap: 24px;
    justify-items: start;
    max-width: 44rem;
  }
  .dist__title {
    max-width: 16ch;
  }
  .dist__regions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .dist__regions li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px 8px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .dist__regions .mono {
    font-size: var(--fs-micro);
    color: var(--azure-200);
    font-weight: 400;
  }
  .dist__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-block-start: 8px;
  }
  .dist .lead {
    color: rgba(255, 255, 255, 0.86);
  }
</style>
