---
/**
 * Technical-sheet illustrations of each product type. Used until product
 * photography arrives (any `images` on a product replace these). Shapes are
 * generic per type/collection; dimensions are shown as letters, not numbers,
 * because no verified dimensions exist yet.
 */
interface Props {
  kind: 'basin' | 'basin-tall' | 'shower' | 'bath' | 'kitchen' | 'hose' | 'valve' | 'cartridge';
  shape?: 'square' | 'round' | 'oval' | 'classic';
  code?: string;
  class?: string;
  label?: string;
}
const { kind, shape = 'round', code = '', class: cls, label } = Astro.props;
const id = `g${Math.random().toString(36).slice(2, 8)}`;
const chrome = `url(#${id}-chrome)`;
const cap = shape === 'square' ? 3 : shape === 'oval' ? 14 : shape === 'classic' ? 8 : 6;

// Basin geometry
const tall = kind === 'basin-tall';
const top = tall ? 70 : 178;
const spoutY = tall ? 100 : 206;
const spoutTip = tall ? 62 : 74;
---
<svg class:list={['pd', `pd--${kind}`, cls]} viewBox="0 0 400 440" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} data-drawing>
  <defs>
    <linearGradient id={`${id}-chrome`} x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset=".22" stop-color="#dbe6f0" />
      <stop offset=".45" stop-color="#ffffff" />
      <stop offset=".62" stop-color="#c3d4e4" />
      <stop offset=".86" stop-color="#eef3f8" />
      <stop offset="1" stop-color="#b9cbdc" />
    </linearGradient>
    <linearGradient id={`${id}-chrome-v`} x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset=".35" stop-color="#d6e2ee" />
      <stop offset=".6" stop-color="#ffffff" />
      <stop offset="1" stop-color="#bfd0e1" />
    </linearGradient>
  </defs>

  <!-- sheet furniture: crop marks + title block -->
  <g class="pd__sheet">
    <path d="M14 30V14h16M370 14h16v16M386 410v16h-16M30 426H14v-16" />
    <text x="24" y="416" class="pd__tb">{code}</text>
    <text x="376" y="416" class="pd__tb" text-anchor="end">NTS</text>
  </g>

  {(kind === 'basin' || kind === 'basin-tall') && (
    <g>
      <line class="pd__ground" x1="36" y1="372" x2="364" y2="372" />
      <!-- water stream -->
      <line class="pd__water" x1={spoutTip + 16} y1={spoutY + 30} x2={spoutTip + 16} y2="370" />
      {shape === 'classic' ? (
        <g class="pd__body" fill={chrome}>
          <path class="dw" d={`M178 372h64v-10c0-6-6-8-12-10v-${352 - top - 18}c0-8 -6-${8} -20-8s-20 0-20 8v${352 - top - 18}c-6 2-12 4-12 10z`} />
          <path class="dw" d={`M196 ${spoutY + 2}c-40-34-110-34-124 14 -2 8 0 18 2 24h18c-2-6-2-12 0-16 10-26 62-22 92 4z`} />
          <rect class="dw" x={spoutTip + 2} y={spoutY + 38} width="20" height="7" rx="2" />
          <path class="dw" d={`M200 ${top + 4}c0-12 4-16 10-16s10 4 10 16`} />
          <path class="dw" d={`M206 ${top - 10}l26-70c2-6 10-4 9 2l-17 70z`} />
          <circle class="dw" cx="238" cy={top - 82} r="7" />
        </g>
      ) : (
        <g class="pd__body" fill={chrome}>
          <!-- base plate -->
          <rect class="dw" x="176" y="364" width="68" height="8" rx={Math.min(cap, 4)} />
          <!-- body -->
          {shape === 'oval' ? (
            <path class="dw" d={`M184 364L190 ${top + 12}Q192 ${top} 210 ${top}Q228 ${top} 230 ${top + 12}L236 364Z`} />
          ) : (
            <rect class="dw" x="186" y={top} width="48" height={364 - top} rx={cap} />
          )}
          <!-- spout -->
          {shape === 'oval' ? (
            <path class="dw" d={`M192 ${spoutY}L${spoutTip + 8} ${spoutY + 10}Q${spoutTip - 2} ${spoutY + 11} ${spoutTip - 2} ${spoutY + 21}Q${spoutTip - 2} ${spoutY + 30} ${spoutTip + 8} ${spoutY + 30}L192 ${spoutY + 24}Z`} />
          ) : (
            <rect class="dw" x={spoutTip} y={spoutY} width={190 - spoutTip} height="24" rx={shape === 'square' ? 2 : 12} />
          )}
          <!-- aerator -->
          <rect class="dw pd__dark" x={spoutTip + 6} y={spoutY + (shape === 'oval' ? 30 : 24)} width="20" height="5" rx="1.5" />
          <!-- lever -->
          <rect class="dw" x="192" y={top - 12} width="36" height="12" rx={shape === 'square' ? 2 : 5} />
          <g transform={`rotate(${shape === 'square' ? -8 : -14} 214 ${top - 12})`}>
            <rect class="dw" x="206" y={top - 22} width={shape === 'square' ? 86 : 78} height={shape === 'square' ? 10 : 9} rx={shape === 'square' ? 1.5 : 4.5} />
          </g>
          <!-- highlights -->
          <line class="pd__hl" x1="198" y1={top + 8} x2="198" y2="360" />
          {shape === 'square' && <line class="pd__hl" x1="226" y1={top + 4} x2="226" y2="362" />}
        </g>
      )}
      <!-- dims -->
      <g class="pd__dim">
        <path d={`M300 ${top - (shape === 'classic' ? 90 : 26)}v${372 - top + (shape === 'classic' ? 90 : 26)}M294 ${top - (shape === 'classic' ? 90 : 26)}h12M294 372h12`} />
        <text x="312" y={(top + 372) / 2} class="pd__lbl">H</text>
        <path d={`M${spoutTip + 16} ${spoutY - 34}h${210 - spoutTip - 16}M${spoutTip + 16} ${spoutY - 40}v12M210 ${spoutY - 40}v12`} />
        <text x={(spoutTip + 226) / 2} y={spoutY - 42} class="pd__lbl" text-anchor="middle">L</text>
      </g>
      <!-- plan view -->
      <g class="pd__plan" transform={tall ? 'translate(350 318)' : 'translate(336 52)'}>
        {shape === 'square' && <rect class="dw" x="-14" y="-14" width="28" height="28" rx="2" />}
        {shape === 'round' && <circle class="dw" r="15" />}
        {shape === 'oval' && <ellipse class="dw" rx="19" ry="12" />}
        {shape === 'classic' && <><circle class="dw" r="16" /><circle class="dw" r="10" /></>}
        <text y="34" class="pd__lbl pd__lbl--sm" text-anchor="middle">PLAN</text>
      </g>
    </g>
  )}

  {(kind === 'shower' || kind === 'bath' || kind === 'kitchen') && (
    <g>
      <line class="pd__ground" x1="36" y1="90" x2="364" y2="90" stroke-dasharray="2 6" />
      <g class="pd__body" fill={`url(#${id}-chrome-v)`}>
        <!-- wall escutcheons -->
        <rect class="dw" x="98" y="172" width="28" height="64" rx={shape === 'square' ? 3 : 14} />
        <rect class="dw" x="274" y="172" width="28" height="64" rx={shape === 'square' ? 3 : 14} />
        <!-- body -->
        <rect class="dw" x="88" y="182" width="224" height="44" rx={shape === 'square' ? 3 : 22} />
        {shape === 'classic' && (
          <>
            <line class="dw" x1="118" y1="182" x2="118" y2="226" />
            <line class="dw" x1="282" y1="182" x2="282" y2="226" />
          </>
        )}
        <!-- lever -->
        <rect class="dw" x="184" y="166" width="32" height="16" rx={shape === 'square' ? 2 : 6} />
        <g transform="rotate(-16 200 166)">
          <rect class="dw" x="194" y="156" width="88" height="10" rx={shape === 'square' ? 1.5 : 5} />
        </g>
        {kind === 'shower' && (
          <>
            <rect class="dw" x="190" y="226" width="20" height="26" rx="3" />
            <path class="dw" d="M192 238h16M192 244h16" />
            <path class="pd__hose" d="M200 252c0 60 -20 90 -70 112" />
          </>
        )}
        {kind === 'bath' && (
          <>
            <path class="dw" d="M182 226h36l-6 72c-1 6-5 8-12 8s-11-2-12-8z" />
            <rect class="dw pd__dark" x="190" y="304" width="20" height="5" rx="1.5" />
            <rect class="dw" x="194" y="238" width="12" height="20" rx="3" />
            <rect class="dw" x="276" y="148" width="20" height="34" rx="3" />
            <line class="pd__water" x1="200" y1="312" x2="200" y2="400" />
          </>
        )}
        {kind === 'kitchen' && (
          <>
            <rect class="dw" x="188" y="226" width="24" height="14" rx="3" />
            <path class="dw" d="M190 240v26c0 26 -14 36 -40 36h-80v-20h80c12 0 16-4 16-16v-26z" />
            <rect class="dw pd__dark" x="66" y="302" width="18" height="5" rx="1.5" />
            <line class="pd__water" x1="75" y1="310" x2="75" y2="400" />
            <path class="pd__swing" d="M70 336a130 44 0 0 0 260 0" />
            <path class="pd__swing-head" d="M63 330l7 6 8-4M337 330l-7 6-8-4" />
          </>
        )}
        <line class="pd__hl" x1="100" y1="194" x2="300" y2="194" />
      </g>
      <g class="pd__dim">
        <path d="M112 132v-14M288 132v-14M112 125h176" />
        <text x="200" y="118" class="pd__lbl" text-anchor="middle">C</text>
      </g>
    </g>
  )}

  {kind === 'hose' && (
    <g>
      <g class="pd__body">
        <path class="pd__tube" d="M92 116c80 0 40 90 108 90s28 100 108 100" />
        <path class="pd__braid" d="M92 116c80 0 40 90 108 90s28 100 108 100" />
        <g fill={`url(#${id}-chrome-v)`}>
          <path class="dw" d="M40 100h40l6 6v20l-6 6H40l-6-6v-20z" />
          <path class="dw" d="M40 108h46M40 124h46" />
          <rect class="dw" x="86" y="106" width="14" height="20" rx="2" />
          <rect class="dw" x="300" y="296" width="14" height="20" rx="2" />
          <path class="dw" d="M314 302h40v12h-40z" />
          <path class="dw" d="M322 314v-12M330 314v-12M338 314v-12M346 314v-12" />
        </g>
      </g>
      <g class="pd__dim">
        <path d="M60 360h270M60 352v16M330 352v16" />
        <text x="195" y="350" class="pd__lbl" text-anchor="middle">L</text>
      </g>
    </g>
  )}

  {kind === 'valve' && (
    <g>
      <line class="pd__ground" x1="70" y1="60" x2="70" y2="380" stroke-dasharray="2 6" />
      <g class="pd__body" fill={`url(#${id}-chrome-v)`}>
        <rect class="dw" x="70" y="176" width="16" height="64" rx="3" />
        <rect class="dw" x="86" y="190" width="150" height="36" rx="6" />
        <path class="dw" d="M100 190v36M112 190v36" />
        <rect class="dw" x="160" y="226" width="36" height="70" rx="4" />
        <path class="dw" d="M160 270h36M160 280h36M160 290h36" />
        <rect class="dw" x="236" y="198" width="30" height="20" rx="3" />
        <path class="dw" d="M266 182h18c8 0 12 6 12 26s-4 26-12 26h-18z" />
      </g>
      <g class="pd__dim">
        <path d="M70 330h108M70 322v16M178 322v16" />
        <text x="124" y="320" class="pd__lbl" text-anchor="middle">G ½″</text>
        <path d="M216 296v40" />
        <text x="226" y="330" class="pd__lbl">G ½″</text>
      </g>
    </g>
  )}

  {kind === 'cartridge' && (
    <g>
      <g class="pd__body" fill={`url(#${id}-chrome)`}>
        <rect class="dw" x="190" y="66" width="20" height="44" rx="2" />
        <path class="dw" d="M190 74h20M190 82h20M190 90h20M190 98h20" />
        <rect class="dw" x="176" y="110" width="48" height="34" rx="4" />
        <rect class="dw" x="160" y="144" width="80" height="156" rx="6" />
        <rect class="dw pd__dark" x="174" y="200" width="16" height="22" rx="3" />
        <rect class="dw pd__dark" x="210" y="200" width="16" height="22" rx="3" />
        <rect class="dw" x="152" y="300" width="96" height="22" rx="4" />
        <path class="dw" d="M168 322v10h64v-10" />
      </g>
      <g class="pd__dim">
        <path d="M152 362h96M152 354v16M248 354v16" />
        <text x="200" y="352" class="pd__lbl" text-anchor="middle">Ø</text>
        <path d="M290 66v266M282 66h16M282 332h16" />
        <text x="302" y="204" class="pd__lbl">H</text>
      </g>
    </g>
  )}
</svg>

<style>
  .pd {
    width: 100%;
    height: auto;
    color: var(--atlantic);
    overflow: visible;
  }
  .pd :global(.dw) {
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .pd__ground,
  .pd__sheet path {
    stroke: currentColor;
    stroke-width: 1.3;
    vector-effect: non-scaling-stroke;
  }
  .pd__plan :global(.dw) {
    fill: none;
  }
  .pd__dark {
    fill: var(--atlantic) !important;
    fill-opacity: 0.2;
  }
  .pd__ground {
    stroke-opacity: 0.35;
  }
  .pd__sheet path {
    fill: none;
    stroke-opacity: 0.35;
  }
  .pd__tb {
    font: 500 10px var(--mono);
    letter-spacing: 0.08em;
    fill: currentColor;
    fill-opacity: 0.6;
  }
  .pd__hl {
    stroke: #fff;
    stroke-width: 2;
    stroke-opacity: 0.9;
    vector-effect: non-scaling-stroke;
  }
  .pd__dim path {
    fill: none;
    stroke: var(--azure);
    stroke-width: 0.9;
    vector-effect: non-scaling-stroke;
  }
  .pd__lbl {
    font: 500 12px var(--mono);
    fill: var(--azure);
  }
  .pd__lbl--sm {
    font-size: 8px;
    letter-spacing: 0.16em;
    fill: currentColor;
    fill-opacity: 0.6;
  }
  .pd__water {
    stroke: var(--azure);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 2 9;
    animation: pd-flow 0.9s linear infinite;
    vector-effect: non-scaling-stroke;
  }
  @keyframes pd-flow {
    to {
      stroke-dashoffset: -11;
    }
  }
  .pd__hose,
  .pd__swing {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-dasharray: 4 4;
    stroke-opacity: 0.6;
    vector-effect: non-scaling-stroke;
  }
  .pd__swing {
    stroke: var(--azure);
    stroke-opacity: 1;
  }
  .pd__swing-head {
    fill: none;
    stroke: var(--azure);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pd__tube {
    fill: none;
    stroke: currentColor;
    stroke-width: 16;
    stroke-linecap: round;
  }
  .pd__braid {
    fill: none;
    stroke: #eef3f8;
    stroke-width: 13.4;
    stroke-linecap: round;
    stroke-dasharray: 1.5 2.5;
  }
</style>
