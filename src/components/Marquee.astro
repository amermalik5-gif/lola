---
import { PETALS } from '../lib/brand';
interface Props { items: string[] }
const { items } = Astro.props;
---
<div class="marquee" data-marquee aria-hidden="true">
  <div class="marquee__track" data-marquee-track>
    <div class="marquee__set">
      {items.map((it) => (
        <>
          <span class="marquee__item" lang={/[؀-ۿ]/.test(it) ? 'ar' : 'en'}>{it}</span>
          <svg class="marquee__mark" viewBox="0 0 204 140"><g>{PETALS.map((d) => <path d={d} />)}</g></svg>
        </>
      ))}
    </div>
  </div>
</div>
<style>
  .marquee {
    overflow: hidden;
    padding-block: clamp(22px, 3vw, 36px);
    border-block: 1px solid var(--line);
    background: var(--paper);
    direction: ltr;
  }
  .marquee__track {
    display: flex;
    width: max-content;
  }
  .marquee__set {
    display: flex;
    align-items: center;
    flex: none;
  }
  .marquee__item {
    font-size: clamp(1.8rem, 1rem + 3.4vw, 4rem);
    font-weight: 700;
    white-space: nowrap;
    padding-inline: clamp(20px, 3vw, 44px);
    color: var(--atlantic);
    line-height: 1.3;
  }
  .marquee__item:nth-of-type(even) {
    color: transparent;
    -webkit-text-stroke: 1px var(--atlantic);
  }
  .marquee__mark {
    width: clamp(34px, 3.6vw, 56px);
    flex: none;
    fill: var(--azure);
  }
</style>
